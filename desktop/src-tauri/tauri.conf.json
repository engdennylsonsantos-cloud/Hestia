{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hestia",
  "version": "0.2.0",
  "identifier": "com.hestiabim.app",
  "build": {
    "frontendDist": "../../apps/web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hestia",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-inline' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; connect-src 'self' blob: data: https:; font-src 'self' data: https://fonts.gstatic.com",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5N0RERTJGM0I3MzBFQTgKUldTb0RuTTdMOTU5bVFlbFFkRXM1ZndmWGJMUUQva0ZxM214VFZ2VnpwaXNhOFpFbnh5eGhUSlQK",
      "endpoints": [
        "https://github.com/engdennylsonsantos-cloud/Hestia/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
