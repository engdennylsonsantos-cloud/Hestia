+
+/**
+ * Nó de 3+ paredes pareando por vizinho angular (docs/08 §5.4 passo 2, em avaliação): cada parede pareia com o
+ * vizinho de cada lado — `hi` com o que está do lado de s maior, `lo` com o outro — usando o mesmo pareamento da
+ * junção de duas paredes.
+ */
+export function angularNode(out: Map<string, WallEnds>, g: EndRef[]): void {
+  const refs = [...g].sort((x, y) => Math.atan2(x.dir.y, x.dir.x) - Math.atan2(y.dir.y, y.dir.x));
+  const n = refs.length;
+  refs.forEach((r, i) => {
+    const prev = refs[(i + n - 1) % n]!;
+    const next = refs[(i + 1) % n]!;
+    const dPrev = dot(r.f.n, prev.dir);
+    const dNext = dot(r.f.n, next.dir);
+    const hi = dNext >= dPrev ? next : prev;
+    const lo = hi === next ? prev : next;
+    if (Math.max(dPrev, dNext) > 1e-9) pairSide(out, r, hi, 'hi');
+    if (Math.min(dPrev, dNext) < -1e-9) pairSide(out, r, lo, 'lo');
+  });
+}
+
+function pairSide(out: Map<string, WallEnds>, r: EndRef, neighbor: EndRef, side: 'hi' | 'lo'): void {
+  const specs = pairSpecs(r, neighbor);
+  if (!specs) return;
+  const spec: SideSpec = pairRoles(r, neighbor).lead === r ? specs.lead : specs.follower;
+  const end = out.get(r.f.wall.id);
+  if (end) end[r.which] = { ...end[r.which], [side]: spec };
+}
