{
  "name": "hestia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @hestia/web",
    "build": "npm run build -w @hestia/web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && node scripts/check-boundaries.mjs && node scripts/check-parity.mjs",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "e2e": "node tests/e2e/flow.mjs",
    "build:artifact": "npm run build && node scripts/make-artifact.mjs",
    "parity": "node scripts/check-parity.mjs --report",
    "test:rapido": "vitest run --exclude \"**/property.test.ts\" --exclude \"**/perf.test.ts\"",
    "test:completo": "VITE_FULL=1 vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
